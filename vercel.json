{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/video",
      "destination": "/video.html"
    },
    {
      "source": "/((?!api/|video\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
