{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/video",
      "destination": "/demo.html"
    },
    {
      "source": "/((?!api/|demo\\.html|video\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
